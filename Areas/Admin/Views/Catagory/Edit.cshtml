@model Catagory
<form asp-controller="Catagory" asp-action="Update" method="post">
    <div class="form-floating mb-3">
        
            <label class="form-label" asp-for="Status">Select</label>
        <select class="form-select" asp-for="Status">
                
                <option>Active</option>
                <option class="InActive">InActive</option>
                
            </select>
        
        <input asp-for="Name" class="form-control" placeholder="Catagory Name">
        <label asp-for="Name">Name</label>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg">Update</button>
</form>